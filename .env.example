# Copy to .env and provide your own credentials and manifest path.
# Compose and the Spring local profile load .env. For the CLI: set -a; source .env; set +a
# Keep values compatible with both Java properties and shell syntax (no quotes/expansion).
MODEL_STORAGE_ENABLED=true
MODEL_STORAGE_ENDPOINT=http://localhost:8333
# A Spring container on the Compose network uses http://seaweedfs:8333 instead.
MODEL_STORAGE_PORT=8333
MODEL_STORAGE_PUBLIC_BASE_URL=http://localhost:8333/pokemon-assets
MODEL_STORAGE_REGION=us-east-1
MODEL_STORAGE_BUCKET=pokemon-assets
MODEL_STORAGE_PREFIX=pokemon
MODEL_STORAGE_ACCESS_KEY=
MODEL_STORAGE_SECRET_KEY=
MODEL_STORAGE_PATH_STYLE=true
MODEL_STORAGE_CONNECT_TIMEOUT=3s
MODEL_STORAGE_ATTEMPT_TIMEOUT=60s
MODEL_STORAGE_REQUEST_TIMEOUT=180s
POKEMON_MODELS_MANIFEST_PATH=
